{
  "name": "earmark-stamp",
  "version": "0.1.0",
  "description": "Bundler-agnostic source stamping for earmark — adds data-earmark-src file:line:col to JSX and Svelte elements.",
  "keywords": [
    "earmark",
    "jsx",
    "svelte",
    "source",
    "devtools"
  ],
  "license": "MIT",
  "author": "nahar-strativ",
  "homepage": "https://github.com/nahar-strativ/earmark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahar-strativ/earmark.git",
    "directory": "packages/stamp"
  },
  "bugs": {
    "url": "https://github.com/nahar-strativ/earmark/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts",
      "default": "./src/jsx.js"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts",
      "default": "./src/svelte.js"
    }
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "magic-string": "^0.30.0"
  }
}
