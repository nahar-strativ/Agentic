{
  "name": "vite-plugin-earmark",
  "version": "0.1.0",
  "description": "Stamps JSX and Svelte elements with their source file, line and column so earmark annotations point straight at the code.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "peerDependencies": {
    "vite": ">=4"
  },
  "dependencies": {
    "earmark-stamp": "0.1.0"
  },
  "license": "MIT"
}
