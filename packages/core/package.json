{
  "name": "earmark",
  "version": "0.1.0",
  "description": "Click-to-annotate overlay that gives AI coding agents structured context about your UI.",
  "keywords": [
    "annotation",
    "ai",
    "agent",
    "mcp",
    "devtools",
    "feedback"
  ],
  "license": "MIT",
  "author": "nahar-strativ",
  "homepage": "https://github.com/nahar-strativ/earmark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahar-strativ/earmark.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nahar-strativ/earmark/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./markdown": {
      "types": "./types/markdown.d.ts",
      "default": "./src/markdown.js"
    },
    "./extract": {
      "types": "./types/extract.d.ts",
      "default": "./src/extract.js"
    },
    "./selector": {
      "types": "./types/selector.d.ts",
      "default": "./src/selector.js"
    },
    "./sourcemap": {
      "types": "./types/sourcemap.d.ts",
      "default": "./src/sourcemap.js"
    },
    "./transport": {
      "types": "./types/transport.d.ts",
      "default": "./src/transport.js"
    }
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
