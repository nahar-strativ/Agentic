{
  "name": "earmark-server",
  "version": "0.1.0",
  "description": "Local dev server that brokers earmark annotations between the browser overlay and AI agents.",
  "license": "MIT",
  "author": "nahar-strativ",
  "homepage": "https://github.com/nahar-strativ/earmark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahar-strativ/earmark.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/nahar-strativ/earmark/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./store": {
      "types": "./types/store.d.ts",
      "default": "./src/store.js"
    },
    "./http": {
      "types": "./types/http.d.ts",
      "default": "./src/http.js"
    }
  },
  "bin": {
    "earmark-server": "./bin/earmark-server.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "earmark": "0.1.0"
  }
}
