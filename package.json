{
  "name": "earmark-monorepo",
  "private": true,
  "version": "0.1.1",
  "description": "Visual feedback tooling for AI coding agents.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "server": "node packages/server/bin/earmark-server.js",
    "mcp": "node packages/mcp/bin/earmark-mcp.js",
    "example": "node examples/serve.js",
    "site:fragment": "node site/build-fragment.js",
    "types": "tsc -p tsconfig.json",
    "verify": "node scripts/verify.mjs",
    "release": "npm test && npm run verify && npm publish --workspaces --access public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
